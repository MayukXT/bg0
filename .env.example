# Local browser removal needs no environment variables.
# Set this only when testing analytics away from bg0.dev. Production analytics
# is restricted to bg0.dev and www.bg0.dev.

# The web app proxies /docs to this origin during development.
# BG0_DOCS_ORIGIN=http://localhost:4321

# The docs logo links here during development. Production defaults to bg0.dev.
# BG0_PRODUCT_URL=http://localhost:3000
